{
  "expo": {
    "name": "CORNER69",
    "slug": "corner69-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "corner69",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1114",
    "splash": {
      "backgroundColor": "#0F1114",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.corner69.admin"
    },
    "android": {
      "package": "com.corner69.admin",
      "adaptiveIcon": {
        "backgroundColor": "#0F1114"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
